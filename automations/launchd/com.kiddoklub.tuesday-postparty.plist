<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>           <string>com.kiddoklub.tuesday-postparty</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>~/Projects/kiddoklub/automations/scripts/tuesday_postparty.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key> <integer>2</integer>
    <key>Hour</key>    <integer>10</integer>
    <key>Minute</key>  <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>  <string>/tmp/kiddoklub-tuesday-postparty.log</string>
  <key>StandardErrorPath</key><string>/tmp/kiddoklub-tuesday-postparty.err</string>
  <key>RunAtLoad</key>        <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/ivankruger/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/ivankruger</string>
  </dict>
</dict>
</plist>
