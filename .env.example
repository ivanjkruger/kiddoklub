# KiddoKlub environment — copy to .env.local (gitignored) and fill from Keychain
# Source values via: security find-generic-password -s NAME -a ivan -w
#
# All secrets are stored in macOS Keychain per global rule. Never commit real values.

NEXT_PUBLIC_KIDDOKLUB_SUPABASE_URL=
NEXT_PUBLIC_KIDDOKLUB_SUPABASE_ANON_KEY=
KIDDOKLUB_SUPABASE_SERVICE_KEY=

# Cal.com webhook signing secret (set in Cal webhook config UI, copy here)
KIDDOKLUB_CAL_WEBHOOK_SECRET=

# Skipcash
KIDDOKLUB_SKIPCASH_API_KEY=
KIDDOKLUB_SKIPCASH_WEBHOOK_SECRET=
KIDDOKLUB_SKIPCASH_BASE_URL=https://api.skipcash.app

# Wati (Phase 2 — Day 30+)
KIDDOKLUB_WATI_API_KEY=
KIDDOKLUB_WATI_BASE_URL=

# Resend (transactional email)
KIDDOKLUB_RESEND_API_KEY=
KIDDOKLUB_RESEND_FROM=hello@kiddoklub.com

# Telegram bot (shared with James)
IVAN_JAMES_BOT_TOKEN=
IVAN_TELEGRAM_CHAT_ID=
